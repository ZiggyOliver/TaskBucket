from ui_mainwindow import Ui_MainWindow
from PySide6.QtWidgets import (QMainWindow, QApplication, QPushButton)
from PySide6.QtCore import Signal, Slot
import sys
import createBucket
from createBucket import MainWindow as BucketWindow
class MainWindow(QMainWindow):
    def __init__(self):
        super(MainWindow, self).__init__()
        self.ui = Ui_MainWindow()
        self.ui.setupUi(self)

    @Slot()
    def LoadAddBuckets():
        print("Load Add Buckets Called")
        self.window = BucketWindow()
        self.window.show()

app = QApplication.instance()
if app == None: app = QApplication(sys.argv)

window = MainWindow()

@Slot()
def LoadAddTask():
    import createTask
window.ui.addTasksButton.clicked.connect(LoadAddTask)

@Slot()
def LoadAddBuckets():
    print("Load Add Buckets Called")
    bucketWindow = BucketWindow()
    bucketWindow.show()

window.ui.addBucketsButton.clicked.connect(LoadAddBuckets)

@Slot()
def LoadCalendar():
    import Calendar
window.ui.viewCalendarButton.clicked.connect(LoadCalendar)


if __name__ == "__main__":
    window.show()
    sys.exit(app.exec())
